# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and coverage outputs
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment files and secrets
.env
.env.*
*.key
*.pem
secrets.json
competitions/eris/.session*
competitions/eris/.token*

# IDE/editor folders
.idea/
.vscode/
.cursor/

# OS files
.DS_Store
Thumbs.db

# Logs and run output
*.log
runs/
*output/
*output*/

# Playwright/browser automation artifacts
playwright-report/
test-results/

# Local Chrome/automation profile (if pointed at project dir)
chrome_profile/
automation_data/

# Jupyter
.ipynb_checkpoints/

# Editor backups
*.bak
*.swp
*~

# Temporary test outputs and cloned reference repos
tmp/
openclaw/
openclaw_repo/
openclaw_src/
*.sqlite
*.png


# uiautomation debug log (written into CWD as a side effect)
@AutomationLog.txt

# Learned skills are per-machine runtime data, not source.
# Committing them ships one user's (possibly stale) lessons to everyone.
autobot/knowledge/skills/

# Competition heavy binaries, model weights, and submission outputs
competitions/**/output*/
competitions/**/*.csv
competitions/**/*.zip
competitions/**/*.parquet
competitions/**/*.pth
competitions/**/*.pt
competitions/**/*.whl
competitions/**/official_repo/

